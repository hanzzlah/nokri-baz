# ==============================================================================
# Supabase PostgreSQL Configuration
# ==============================================================================

# Database host. 
# Use the Supabase IPv4 Pooler host to prevent IPv6 DNS resolution issues.
# Example: aws-0-ap-southeast-1.pooler.supabase.com
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com

# Database port.
# Use port 6543 for the Supabase Transaction Pooler (recommended for scripts).
# Default direct PostgreSQL port is 5432.
DB_PORT=6543

# Name of the database to connect to (default is 'postgres' for Supabase).
DB_NAME=postgres

# Database user name.
# For Supabase pooler connections, use the format: postgres.[YOUR-PROJECT-REF]
# Example: postgres.dgxprhinyapdxqejwbqu
DB_USER=postgres.your_project_ref

# Database password set in your Supabase project settings.
# If password contains special characters (#, $, @), enclose it in double quotes.
DB_PASS="your_secure_password_here"